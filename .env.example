# =============================================================================
# snitch - example configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Token from @BotFather. Treat like a password.
BOT_TOKEN=123456789:AAreplace_me_with_your_real_token

# The supergroup the bot guards. Numeric id starts with -100 (e.g. -1001234567890).
# You may use @groupusername instead. Find it by forwarding any chat message to
# @userinfobot, or by running /id in the group.
CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# PROXY (optional)
# -----------------------------------------------------------------------------
# Route every Telegram API call through a proxy. Leave empty to connect
# directly, which is the normal case.
#
# Supported schemes: socks5 (recommended), socks4, http, https
#
#   PROXY_URL=socks5://127.0.0.1:1080
#   PROXY_URL=socks5://user:password@proxy.example.com:1080
#   PROXY_URL=http://user:password://proxy.example.com:3128
#
# Notes:
# - Use socks5, NOT socks5h. aiohttp_socks rejects socks5h outright, and it
#   would gain nothing: DNS is always resolved BY the proxy (aiogram sets
#   rdns=True), so your local resolver never sees api.telegram.org.
# - The port may be omitted; it defaults to 1080 for socks and 8080 for http.
# - Percent-encode any password character that is special in a URL
#   (@ : / ? # [ ] becomes %40 %3A %2F %3F %23 %5B %5D). A '@' in a password is
#   the one that bites: it makes the parser read the rest as the hostname.
# - The password is treated as a secret: it is never logged, and it is scrubbed
#   from log output and tracebacks.
# - If the proxy runs on the Docker HOST, 127.0.0.1 is the container itself.
#   Use host.docker.internal or the host's LAN IP instead.
PROXY_URL=

# -----------------------------------------------------------------------------
# THE RULE
# -----------------------------------------------------------------------------

# The users who may not talk to each other. Comma separated.
# Numeric user IDs are strongly preferred: they are permanent.
# @usernames are accepted too, but a user can change their username at any time
# (the bot re-resolves them every DIRECTORY_REFRESH_HOURS and logs a warning if
# a configured username no longer points at the same account).
# Find a user id with @userinfobot.
RESTRICTED_USERS=111111111,222222222

# Forum topic (thread) ids where the rule does NOT apply.
# "general" means the supergroup's General topic (messages there have no
# message_thread_id). Multiple values allowed, e.g. 42,77,general
# Get a topic id by running /id inside that topic.
WHITELIST_TOPIC_IDS=42

# -----------------------------------------------------------------------------
# PUNISHMENT
# -----------------------------------------------------------------------------

# Delete the offending message. This is the primary punishment and it is
# per-message, so the whitelist above works exactly as expected.
DELETE_MESSAGE=true

# Deletions are BATCHED. Telegram's deleteMessages takes up to 100 message ids
# per call, and deleting one at a time is precisely what earns a 429 flood wait
# during a burst - a flood of 1000 violations costs ~11 calls instead of 1000.
#
# A single isolated violation is still deleted immediately and costs one call;
# batching only kicks in once more than one arrives inside the window below.
# There is no added delay to the common case.
DELETE_BATCH_SIZE=100

# How long a queued deletion may wait to be batched, in seconds. This is the
# coalescing window: the first message of a burst is deleted at once, and
# anything arriving within this window is batched with it. Lower it to delete
# sooner at the cost of smaller batches; raise it for larger ones.
DELETE_FLUSH_SECONDS=0.5

# Mute the sender with Telegram's native restrictChatMember.
#
#   !! IMPORTANT !!
#   Telegram permissions are CHAT-WIDE. There is no per-topic mute in the Bot
#   API. So a muted user is silenced in the whitelisted topic as well, and the
#   whitelist only means "no *new* punishments are started from this topic".
#   This is why it is off by default.
MUTE_ENABLED=false

# How long the mute lasts, in hours. Valid range 1..8784 (8784h = 366 days).
# Telegram silently turns anything longer into a *permanent* restriction, so
# this bound is enforced at startup.
MUTE_HOURS=24

# -----------------------------------------------------------------------------
# DETECTION - what counts as "talking to each other"
# -----------------------------------------------------------------------------

# Replying to a restricted user (including replies that cross forum topics).
DETECT_REPLIES=true

# @username mentions and tap-to-mention (tg://user?id=...) entities.
DETECT_MENTIONS=true

# A restricted user's @username appearing as plain text, with no mention
# entity. Fuzzy by nature: it can be evaded by dropping the "@" or by renaming.
DETECT_BARE_USERNAMES=true

# -----------------------------------------------------------------------------
# BEHAVIOUR
# -----------------------------------------------------------------------------

# Never touch messages from the chat owner or administrators. Admins cannot be
# restricted by a bot anyway, and you would not want your moderators muted.
IGNORE_ADMINS=true

# -----------------------------------------------------------------------------
# WORD BLACKLIST (optional)
# -----------------------------------------------------------------------------

# Banned words, in a FILE rather than in .env - because this is the thing you
# actually edit while watching a group. One entry per line:
#
#   forbidden          whole word or phrase, case-insensitive, on word
#                      boundaries. "ass" will NOT match "class" or "bass".
#   re:b[au]zz\w+      a regular expression, for anything a word cannot express
#   # comment          ignored, as are blank lines
#
# The same punishment applies: the message is deleted, and muted if
# MUTE_ENABLED=true. Only the users in RESTRICTED_USERS are held to it.
#
# There is no on/off switch, on purpose. The rule is active exactly when the
# file exists, so there is nothing to configure and nothing to get out of step.
# Leave it unset to use DATA_DIR/wordlist.txt; point it elsewhere to keep the
# list somewhere else. Changes are picked up within a few seconds - no restart.
# Run /blacklist in the group to confirm what is actually loaded.
BLACKLIST_FILE=

# Confirm you have checked @BotFather -> /setprivacy -> <your bot> and it reads
# "Disable", then set this to true.
#
# Privacy mode is not queryable through the Bot API, so snitch cannot check it
# itself and keeps reminding you at every startup. Once you have verified it, set
# this and the reminder stops. It is a permanent property of the bot, not of the
# chat, so there is no reason to set it back to false.
PRIVACY_MODE_VERIFIED=false

# Never act on a message that is OLDER than the moment this process started.
#
# Telegram replays a backlog through getUpdates after any downtime, so on the
# next start the bot receives messages sent while it was down. Leaving this
# false means those are ignored, and only messages from this run are judged.
#
# This is the difference between "you talked to them, so your message is gone"
# and "you talked to them three days ago, so here is a 24 hour mute starting
# now". Punishment belongs to the moment it happens.
#
# Leave it false. Set it to true only if you deliberately want the backlog
# processed on the next start (e.g. a one-off cleanup), and be aware that any
# mute it triggers starts from *then*, not from when the offence happened.
PROCESS_BACKLOG=false

# What to do after a violation, besides deleting the message.
#   log  - structured log record only (default, silent in the chat)
#   chat - post a notice in the same topic
#   dm   - direct message the offender
#   none - nothing
NOTICE_MODE=log

# Optional allowlist of user ids allowed to run /unmute, /check and /status.
# Leave empty to allow the chat owner and all administrators.
ADMIN_IDS=

# How often to re-resolve RESTRICTED_USERS and refresh the username cache.
DIRECTORY_REFRESH_HOURS=6

# Minimum seconds between two mute attempts for the same user. Stops a message
# flood from stacking mutes or hammering the API. Deletion is never throttled.
MUTE_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=text

# Per-request timeout for Telegram API calls, in seconds (5..300).
#
# Lower this if you use a proxy that stalls. aiohttp's own default is 30s and
# the SOCKS connect timeout is 60s, so a proxy that accepts a connection and
# then goes quiet can leave snitch blind for up to a minute per attempt.
# Polling retries on its own, so a shorter value means faster recovery, not
# fewer retries. 15 is a good value for a flaky proxy.
REQUEST_TIMEOUT=30

# Where violations.jsonl (append-only audit log) is written.
#
# In Docker, keep this as-is and let the compose file mount a NAMED volume
# (snitch-data) here. A bind mount ./data:/app/data is owned by whoever
# created it on the host, while the container runs as uid 10001, which gives
# you "Permission denied" on the audit log. If you must use a bind mount, run
# `sudo chown -R 10001:10001 ./data` first.
DATA_DIR=/app/data
