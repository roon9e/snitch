# =============================================================================
# snitch - example configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Token from @BotFather. Treat like a password.
BOT_TOKEN=123456789:AAreplace_me_with_your_real_token

# The supergroup the bot guards. Numeric id starts with -100 (e.g. -1001234567890).
# You may use @groupusername instead. Find it by forwarding any chat message to
# @userinfobot, or by running /id in the group.
CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# THE RULE
# -----------------------------------------------------------------------------

# The users who may not talk to each other. Comma separated.
# Numeric user IDs are strongly preferred: they are permanent.
# @usernames are accepted too, but a user can change their username at any time
# (the bot re-resolves them every DIRECTORY_REFRESH_HOURS and logs a warning if
# a configured username no longer points at the same account).
# Find a user id with @userinfobot.
RESTRICTED_USERS=111111111,222222222

# Forum topic (thread) ids where the rule does NOT apply.
# "general" means the supergroup's General topic (messages there have no
# message_thread_id). Multiple values allowed, e.g. 42,77,general
# Get a topic id by running /id inside that topic.
WHITELIST_TOPIC_IDS=42

# -----------------------------------------------------------------------------
# PUNISHMENT
# -----------------------------------------------------------------------------

# Delete the offending message. This is the primary punishment and it is
# per-message, so the whitelist above works exactly as expected.
DELETE_MESSAGE=true

# Mute the sender with Telegram's native restrictChatMember.
#
#   !! IMPORTANT !!
#   Telegram permissions are CHAT-WIDE. There is no per-topic mute in the Bot
#   API. So a muted user is silenced in the whitelisted topic as well, and the
#   whitelist only means "no *new* punishments are started from this topic".
#   This is why it is off by default.
MUTE_ENABLED=false

# How long the mute lasts, in hours. Valid range 1..8784 (8784h = 366 days).
# Telegram silently turns anything longer into a *permanent* restriction, so
# this bound is enforced at startup.
MUTE_HOURS=24

# -----------------------------------------------------------------------------
# DETECTION - what counts as "talking to each other"
# -----------------------------------------------------------------------------

# Replying to a restricted user (including replies that cross forum topics).
DETECT_REPLIES=true

# @username mentions and tap-to-mention (tg://user?id=...) entities.
DETECT_MENTIONS=true

# A restricted user's @username appearing as plain text, with no mention
# entity. Fuzzy by nature: it can be evaded by dropping the "@" or by renaming.
DETECT_BARE_USERNAMES=true

# -----------------------------------------------------------------------------
# BEHAVIOUR
# -----------------------------------------------------------------------------

# Never touch messages from the chat owner or administrators. Admins cannot be
# restricted by a bot anyway, and you would not want your moderators muted.
IGNORE_ADMINS=true

# What to do after a violation, besides deleting the message.
#   log  - structured log record only (default, silent in the chat)
#   chat - post a notice in the same topic
#   dm   - direct message the offender
#   none - nothing
NOTICE_MODE=log

# Optional allowlist of user ids allowed to run /unmute, /check and /status.
# Leave empty to allow the chat owner and all administrators.
ADMIN_IDS=

# How often to re-resolve RESTRICTED_USERS and refresh the username cache.
DIRECTORY_REFRESH_HOURS=6

# Minimum seconds between two mute attempts for the same user. Stops a message
# flood from stacking mutes or hammering the API. Deletion is never throttled.
MUTE_COOLDOWN_SECONDS=30

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=text

# Where violations.jsonl (append-only audit log) is written.
DATA_DIR=/app/data
